{
   "plugins": ["prettier-plugin-toml"],
   "endOfLine": "lf",
   "printWidth": 100,
   "tabWidth": 3,
   "overrides": [
      {
         "files": [".code-workspace", ".prettierrc"],
         "options": {
            "parser": "json",
            "semi": true
         }
      },
      {
         "files": "*.md",
         "options": {
            "parser": "markdown",
            "proseWrap": "always",
            "tabWidth": 3
         }
      },
      {
         "files": ["*.toml"],
         "options": {
            "alignEntries": true,
            "alignComments": true,
            "indentSubTables": true,
            "indentTableKeyValuePairs": true,
            "keyValueEqualsSignAlignment": true,
            "tabWidth": 3
         }
      },
      {
         "files": ["*.yaml", "*.yml"],
         "options": {
            "tabWidth": 2
         }
      }
   ]
}
